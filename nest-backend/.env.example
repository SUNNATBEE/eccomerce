# Backend muhit o'zgaruvchilari
# Bu faylni .env nomi bilan nusxalab, o'z qiymatlaringizni kiriting

# Server port (default: 5000)
PORT=5000

# MongoDB ulanish manzili
# MongoDB Atlas (tekin bulut) dan olasiz:
# 1. https://www.mongodb.com/atlas ga kiring
# 2. Bepul cluster yarating
# 3. "Connect" > "Drivers" ni tanlang
# 4. Connection string ni nusxalang
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/nest-mart?retryWrites=true&w=majority

# Render ga deploy qilinganda:
# Environment Variables bo'limiga shu o'zgaruvchilarni qo'shing

# Frontend manzili (CORS uchun)
CLIENT_URL=http://localhost:5173

# JWT Secret (kelajakda auth uchun)
JWT_SECRET=nest-mart-super-secret-key-2024
